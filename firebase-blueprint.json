{
  "entities": {
    "bookings": {
      "title": "Flight Bookings & PNR Holds",
      "description": "Stores user flight reservations, passenger details, PNR code, route, pricing, and hold expiry",
      "properties": {
        "pnr": { "type": "string", "description": "Unique 6-character PNR reference code" },
        "passengerName": { "type": "string", "description": "Lead passenger full legal name" },
        "passengerEmail": { "type": "string", "description": "Lead passenger email address" },
        "passengerPhone": { "type": "string", "description": "Lead passenger contact phone" },
        "flightNumber": { "type": "string", "description": "Flight number e.g. BA178" },
        "airline": { "type": "string", "description": "Airline name e.g. British Airways" },
        "origin": { "type": "string", "description": "Departure airport code e.g. JFK" },
        "destination": { "type": "string", "description": "Arrival airport code e.g. LHR" },
        "departDate": { "type": "string", "description": "Departure date string" },
        "returnDate": { "type": "string", "description": "Return date string or null" },
        "cabinClass": { "type": "string", "description": "Cabin class e.g. Business Class" },
        "passengersCount": { "type": "number", "description": "Number of passengers" },
        "retailPrice": { "type": "number", "description": "Original retail fare USD" },
        "royaPrice": { "type": "number", "description": "Discounted Concierge fare USD" },
        "savings": { "type": "number", "description": "Saved USD amount" },
        "status": { "type": "string", "description": "Status e.g. CONFIRMED_HOLD, TICKETED, EXPIRED" },
        "holdExpiresAt": { "type": "string", "description": "ISO timestamp for hold expiry" },
        "createdAt": { "type": "string", "description": "ISO timestamp when hold was created" }
      },
      "required": ["pnr", "passengerName", "passengerEmail", "origin", "destination", "status"]
    },
    "airports": {
      "title": "Airports Directory",
      "description": "Inventory of global airports and airfield hubs supported",
      "properties": {
        "code": { "type": "string", "description": "3-letter IATA airport code" },
        "city": { "type": "string", "description": "City name" },
        "country": { "type": "string", "description": "Country name" },
        "name": { "type": "string", "description": "Official airport name" }
      },
      "required": ["code", "city", "country", "name"]
    },
    "destinations": {
      "title": "Worldwide Destinations",
      "description": "Featured destinations with pricing and branding details",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier e.g. london" },
        "name": { "type": "string", "description": "Display name of city/destination" },
        "airport": { "type": "string", "description": "Associated airport codes" },
        "region": { "type": "string", "description": "Geographical region" },
        "image": { "type": "string", "description": "Unsplash image URL" },
        "retailPrice": { "type": "number", "description": "Retail baseline price USD" },
        "royaPrice": { "type": "number", "description": "Concierge baseline price USD" },
        "discount": { "type": "string", "description": "Discount percentage e.g. 30%" },
        "popular": { "type": "boolean", "description": "Is listed in popular recommendations" },
        "tagline": { "type": "string", "description": "Branding slogan or marketing copy" }
      },
      "required": ["id", "name", "airport", "region"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "bookings",
      "description": "Flight booking documents"
    },
    "/airports/{airportCode}": {
      "schema": "airports",
      "description": "Global airport entries"
    },
    "/destinations/{destinationId}": {
      "schema": "destinations",
      "description": "Worldwide flight destination profiles"
    }
  }
}
