{
  "entities": {
    "bookings": {
      "title": "Flight Bookings & PNR Holds",
      "description": "Stores user flight reservations, passenger details, PNR code, route, pricing, and hold expiry",
      "properties": {
        "pnr": { "type": "string", "description": "Unique 6-character PNR reference code" },
        "passengerName": { "type": "string", "description": "Lead passenger full legal name" },
        "passengerEmail": { "type": "string", "description": "Lead passenger email address" },
        "passengerPhone": { "type": "string", "description": "Lead passenger contact phone" },
        "flightNumber": { "type": "string", "description": "Flight number e.g. BA178" },
        "airline": { "type": "string", "description": "Airline name e.g. British Airways" },
        "origin": { "type": "string", "description": "Departure airport code e.g. JFK" },
        "destination": { "type": "string", "description": "Arrival airport code e.g. LHR" },
        "departDate": { "type": "string", "description": "Departure date string" },
        "returnDate": { "type": "string", "description": "Return date string or null" },
        "cabinClass": { "type": "string", "description": "Cabin class e.g. Business Class" },
        "passengersCount": { "type": "number", "description": "Number of passengers" },
        "retailPrice": { "type": "number", "description": "Original retail fare USD" },
        "royaPrice": { "type": "number", "description": "Discounted Concierge fare USD" },
        "savings": { "type": "number", "description": "Saved USD amount" },
        "status": { "type": "string", "description": "Status e.g. CONFIRMED_HOLD, PAID_TICKET_ISSUED, CANCELLED, EXPIRED" },
        "holdExpiresAt": { "type": "string", "description": "ISO timestamp for hold expiry" },
        "createdAt": { "type": "string", "description": "ISO timestamp when hold was created" }
      },
      "required": ["pnr", "passengerName", "passengerEmail", "origin", "destination", "status"]
    },
    "destinations": {
      "title": "Worldwide Destinations",
      "description": "Featured destinations with pricing and branding details",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier e.g. london" },
        "name": { "type": "string", "description": "Display name of city/destination" },
        "airport": { "type": "string", "description": "Associated airport codes" },
        "region": { "type": "string", "description": "Geographical region" },
        "image": { "type": "string", "description": "Unsplash image URL" },
        "retailPrice": { "type": "number", "description": "Retail baseline price USD" },
        "royaPrice": { "type": "number", "description": "Concierge baseline price USD" },
        "discount": { "type": "string", "description": "Discount percentage e.g. 30%" },
        "popular": { "type": "boolean", "description": "Is listed in popular recommendations" },
        "tagline": { "type": "string", "description": "Branding slogan or marketing copy" }
      },
      "required": ["id", "name", "airport", "region"]
    },
    "flight_statuses": {
      "title": "Flight Status Information",
      "description": "Live flight tracking, route info, gates, terminals, and progress metrics",
      "properties": {
        "flightNumber": { "type": "string", "description": "Flight identifier e.g. BA178" },
        "airline": { "type": "string", "description": "Operating airline name" },
        "origin": { "type": "string", "description": "Origin IATA airport code" },
        "destination": { "type": "string", "description": "Destination IATA airport code" },
        "status": { "type": "string", "description": "Current status e.g. On Time, Boarding, En Route, Landed, Delayed" },
        "departureTerminal": { "type": "string", "description": "Departure terminal" },
        "departureGate": { "type": "string", "description": "Departure gate" },
        "scheduledDeparture": { "type": "string", "description": "Departure time string" },
        "estimatedArrival": { "type": "string", "description": "Arrival time string" },
        "aircraft": { "type": "string", "description": "Aircraft model" },
        "altitude": { "type": "string", "description": "Current flight altitude" },
        "speed": { "type": "string", "description": "Current flight ground speed" },
        "progressPercent": { "type": "number", "description": "Flight route completion percentage" }
      },
      "required": ["flightNumber", "airline", "origin", "destination", "status"]
    },
    "promos": {
      "title": "Promotional Discount Codes",
      "description": "Promo vouchers and percentage/fixed discounts managed by admin",
      "properties": {
        "code": { "type": "string", "description": "Promo voucher code e.g. ROYA30" },
        "discountPercent": { "type": "number", "description": "Discount percentage e.g. 30" },
        "description": { "type": "string", "description": "Promo description banner" },
        "active": { "type": "boolean", "description": "Is promo active" },
        "expiryDate": { "type": "string", "description": "Expiry date string" },
        "usageCount": { "type": "number", "description": "Number of times applied" }
      },
      "required": ["code", "discountPercent", "active"]
    },
    "inquiries": {
      "title": "Customer Contact Inquiries",
      "description": "Direct customer support inquiries and messages",
      "properties": {
        "id": { "type": "string", "description": "Unique inquiry ID" },
        "name": { "type": "string", "description": "Customer name" },
        "email": { "type": "string", "description": "Customer email" },
        "phone": { "type": "string", "description": "Customer phone" },
        "subject": { "type": "string", "description": "Message subject" },
        "message": { "type": "string", "description": "Inquiry body" },
        "status": { "type": "string", "description": "Status: NEW, IN_PROGRESS, RESOLVED" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["name", "email", "message"]
    },
    "admins": {
      "title": "Admin Users",
      "description": "Authorized administrator profiles and access rights",
      "properties": {
        "email": { "type": "string", "description": "Admin email address" },
        "role": { "type": "string", "description": "Role e.g. superadmin, manager" },
        "displayName": { "type": "string", "description": "Admin display name" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "bookings",
      "description": "Flight booking documents"
    },
    "/destinations/{destinationId}": {
      "schema": "destinations",
      "description": "Worldwide flight destination profiles"
    },
    "/flight_statuses/{flightNumber}": {
      "schema": "flight_statuses",
      "description": "Live flight tracking and status records"
    },
    "/promos/{promoId}": {
      "schema": "promos",
      "description": "Promotional discount codes"
    },
    "/inquiries/{inquiryId}": {
      "schema": "inquiries",
      "description": "Customer support contact inquiries"
    },
    "/admins/{adminId}": {
      "schema": "admins",
      "description": "Authorized administrator accounts"
    }
  }
}
