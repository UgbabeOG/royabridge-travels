rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bookings/{bookingId} {
      allow read, create, update: if true;
    }
    match /airports/{airportCode} {
      allow read: if true;
      allow write: if false;
    }
    match /destinations/{destinationId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
