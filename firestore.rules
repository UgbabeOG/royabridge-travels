rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ugbabechoco@gmail.com' ||
        request.auth.token.email == 'support@royabridge.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Bookings Collection (CRUD for Admin, Create & Read/Hold for Users)
    match /bookings/{bookingId} {
      allow read, create, update, delete: if true;
    }

    // Destinations Catalog
    match /destinations/{destinationId} {
      allow read, write: if true;
    }

    // Flight Statuses
    match /flight_statuses/{flightNumber} {
      allow read, write: if true;
    }

    // Promo Codes
    match /promos/{promoId} {
      allow read, write: if true;
    }

    // Inquiries / Support Messages (Open creation from contact form, accessible to admin operations)
    match /inquiries/{inquiryId} {
      allow read, create, update, delete: if true;
    }
  }
}

